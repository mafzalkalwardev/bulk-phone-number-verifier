DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:pass@localhost:5432/phone_verify"
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
REDIS_URL=""
# Optional Redis for BullMQ: REDIS_URL="redis://localhost:6379"
LOOKUP_CACHE_TTL_DAYS="30"

# --- Live HLR (best available) — www.hlr-lookups.com ---
